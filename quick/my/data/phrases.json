{
  "schemaVersion": 1,
  "phrases": [
    {
      "id": "my-000001",
      "text": "好勁呀",
      "jyutping": "hou2 ging6 aa3",
      "meaning": "めっちゃすごい！",
      "category": "リアクション",
      "note": "相手の能力や成果を褒める。",
      "addedAt": "2026-11-26T00:16:58+09:00",
      "updatedAt": "2026-11-26T00:16:58+09:00"
    },
    {
      "id": "my-000002",
      "text": "加油",
      "jyutping": "gaa1 jau4",
      "meaning": "頑張って！",
      "category": "応援",
      "note": "応援・励まし。",
      "addedAt": "2026-11-26T00:16:58+09:00",
      "updatedAt": "2026-11-26T00:16:58+09:00"
    },
    {
      "id": "my-000003",
      "text": "多謝",
      "jyutping": "do1 ze6",
      "meaning": "ありがとう",
      "category": "感謝",
      "note": "贈り物や褒め言葉などへの感謝。",
      "addedAt": "2026-11-26T00:16:58+09:00",
      "updatedAt": "2026-11-26T00:16:58+09:00"
    },
    {
      "id": "my-000004",
      "text": "遲啲聽吓",
      "jyutping": "ci4 di1 teng1 haa5",
      "meaning": "あとでちょっと聞いてみる",
      "category": "日常",
      "note": "「聽下」とも書く。ここでの吓は haa5。読み上げ用には聽下を使用。",
      "addedAt": "2026-11-26T00:16:58+09:00",
      "updatedAt": "2026-11-26T00:16:58+09:00",
      "speechText": "遲啲聽下",
      "variants": [
        "遲啲聽下"
      ]
    },
    {
      "id": "my-000005",
      "text": "好歌",
      "jyutping": "hou2 go1",
      "meaning": "いい曲",
      "category": "音楽",
      "note": "良い歌・曲。",
      "addedAt": "2026-11-26T00:16:58+09:00",
      "updatedAt": "2026-11-26T00:16:58+09:00"
    },
    {
      "id": "my-000006",
      "text": "係",
      "jyutping": "hai6",
      "meaning": "そう・〜である",
      "category": "基本",
      "note": "口語の肯定・コピュラ。",
      "addedAt": "2026-11-26T00:16:58+09:00",
      "updatedAt": "2026-11-26T00:16:58+09:00"
    },
    {
      "id": "my-000007",
      "text": "今日特別凍",
      "jyutping": "gam1 jat6 dak6 bit6 dung3",
      "meaning": "今日は特に寒い",
      "category": "天気",
      "note": "今日＝今日、特別＝特に、凍＝寒い。",
      "addedAt": "2026-11-26T00:16:58+09:00",
      "updatedAt": "2026-11-26T00:16:58+09:00"
    },
    {
      "id": "my-000008",
      "text": "哈囉",
      "jyutping": "haa1 lo2",
      "meaning": "やあ！・ハロー",
      "category": "挨拶",
      "note": "英語 hello 由来のカジュアルな挨拶。囉は lo4 から第2声に変調する読みを採用。lo4 と表記する資料もある。",
      "addedAt": "2026-11-26T01:55:00+09:00",
      "updatedAt": "2026-11-26T01:55:00+09:00"
    },
    {
      "id": "my-000009",
      "text": "拜拜",
      "jyutping": "baai1 baai3",
      "meaning": "バイバイ・またね",
      "category": "挨拶",
      "note": "英語 bye-bye 由来。別れ際や電話を切るときに使う。",
      "addedAt": "2026-11-26T01:55:00+09:00",
      "updatedAt": "2026-11-26T01:55:00+09:00",
      "variants": [
        "掰掰"
      ]
    },
    {
      "id": "my-000010",
      "text": "幾點放工呀",
      "jyutping": "gei2 dim2 fong3 gung1 aa3",
      "meaning": "何時に仕事終わるの？",
      "category": "日常",
      "note": "幾點＝何時、放工＝退勤する、呀＝問いかけを柔らかくする文末助詞。What time do you get off work? メッセージでは「幾點放工呀？😱」とも。",
      "addedAt": "2026-11-26T09:17:00+09:00",
      "updatedAt": "2026-11-26T09:17:00+09:00"
    },
    {
      "id": "my-000011",
      "text": "尋日做到好夜唔敢講幾點",
      "jyutping": "cam4 jat6 zou6 dou3 hou2 je6 m4 gam2 gong2 gei2 dim2",
      "meaning": "昨日はかなり遅くまで働いてた。何時かは言えない（笑）",
      "category": "日常",
      "note": "尋日＝昨日、做到好夜＝かなり遅くまで働く、唔敢講＝言う勇気がない・言えない。メッセージでは「尋日做到好夜，唔敢講幾點😂」と書く。I worked so late yesterday that I don't dare say what time.",
      "speechText": "尋日做到好夜，唔敢講幾點",
      "addedAt": "2026-11-26T09:21:22+09:00",
      "updatedAt": "2026-11-26T09:21:22+09:00"
    },
    {
      "id": "my-000012",
      "text": "小心身體呀",
      "jyutping": "siu2 sam1 san1 tai2 aa3",
      "meaning": "体に気をつけてね！",
      "category": "気遣い",
      "note": "小心＝気をつける、身體＝身体・健康。Take care of yourself!",
      "addedAt": "2026-11-26T19:15:00+09:00",
      "updatedAt": "2026-11-26T19:15:00+09:00"
    },
    {
      "id": "my-000013",
      "text": "你好溫柔呀",
      "jyutping": "nei5 hou2 wan1 jau4 aa3",
      "meaning": "なんて優しいんだ！・本当に優しいね！",
      "category": "リアクション",
      "note": "溫柔＝穏やかで優しい。You're so sweet! 気遣いへの感謝なら「你好貼心呀」も自然。",
      "addedAt": "2026-11-26T19:15:00+09:00",
      "updatedAt": "2026-11-26T19:15:00+09:00"
    },
    {
      "id": "my-000014",
      "text": "聽日見",
      "jyutping": "ting1 jat6 gin3",
      "meaning": "また明日ね！",
      "category": "挨拶",
      "note": "聽日＝明日、見＝会う。翌日会う予定の相手への別れの挨拶。聽日では聽を ting1 と読む。See you tomorrow!",
      "addedAt": "2026-11-26T20:40:00+09:00",
      "updatedAt": "2026-11-26T20:40:00+09:00"
    },
    {
      "id": "my-000015",
      "text": "歡迎你嚟日本",
      "jyutping": "fun1 jing4 nei5 lai4 jat6 bun2",
      "meaning": "日本へようこそ！",
      "category": "挨拶",
      "note": "歡迎＝歓迎する、你＝あなた、嚟＝来る。香港の口語で親しみのある歓迎の挨拶。短く「歡迎嚟日本」とも言える。Welcome to Japan!",
      "addedAt": "2026-11-27T11:19:00+09:00",
      "updatedAt": "2026-11-27T11:19:00+09:00",
      "variants": [
        "歡迎嚟日本"
      ]
    },
    {
      "id": "my-000016",
      "text": "媽媽到咗日本喇",
      "jyutping": "maa4 maa1 dou3 zo2 jat6 bun2 laa3",
      "meaning": "お母さんが日本に到着したよ！",
      "category": "日常",
      "note": "媽媽＝お母さん、到咗＝到着した、喇＝状況の変化を伝える文末助詞。到咗＋場所＋喇で到着を報告できる。Mom has arrived in Japan!",
      "addedAt": "2026-11-27T11:21:25+09:00",
      "updatedAt": "2026-11-27T11:21:25+09:00"
    },
    {
      "id": "my-000017",
      "text": "唔好意思呀",
      "jyutping": "m4 hou2 ji3 si3 aa3",
      "meaning": "ごめんね！・すみません！",
      "category": "謝罪",
      "note": "軽い謝罪や声かけ。",
      "addedAt": "2026-11-27T20:02:00+09:00",
      "updatedAt": "2026-11-27T20:02:00+09:00"
    },
    {
      "id": "my-000018",
      "text": "唔緊要呀",
      "jyutping": "m4 gan2 jiu3 aa3",
      "meaning": "大丈夫だよ！・気にしないで！",
      "category": "気遣い",
      "note": "相手の謝罪への返事。",
      "addedAt": "2026-11-27T20:02:00+09:00",
      "updatedAt": "2026-11-27T20:02:00+09:00"
    },
    {
      "id": "my-000019",
      "text": "唔使急呀",
      "jyutping": "m4 sai2 gap1 aa3",
      "meaning": "急がなくていいよ！",
      "category": "気遣い",
      "note": "急の末子音 p は唇を閉じて終える。",
      "addedAt": "2026-11-27T20:02:00+09:00",
      "updatedAt": "2026-11-27T20:02:00+09:00"
    },
    {
      "id": "my-000020",
      "text": "慢慢嚟啦",
      "jyutping": "maan6 maan6 lai4 laa1",
      "meaning": "ゆっくりでいいよ！",
      "category": "気遣い",
      "note": "焦らず進めるよう促す表現。",
      "addedAt": "2026-11-27T20:02:00+09:00",
      "updatedAt": "2026-11-27T20:02:00+09:00"
    }
  ],
